FROM ubuntu:22.04

RUN apt-get update && apt-get install -y wget bzip2 && rm -rf /var/lib/apt/lists/*

WORKDIR /srv/xmr

RUN wget https://getmonero.org \
    && tar -xjvf monero-linux-x64-v0.18.3.4.tar.bz2 \
    && cp monero-x86_64-linux-gnu-v0.18.3.4/monero-wallet-rpc . \
    && rm -rf monero-linux-x64-v0.18.3.4.tar.bz2 monero-x86_64-linux-gnu-v0.18.3.4

EXPOSE 18083

CMD ./monero-wallet-rpc \
    --rpc-bind-ip 0.0.0.0 --rpc-bind-port 18083 \
    --daemon-address https://moneroworld.com \
    --wallet-dir /srv/xmr/wallets \
    --disable-rpc-login \
    --generate-from-view-key viewonly_wallet \
    --password-file /dev/null \
    --non-interactive
