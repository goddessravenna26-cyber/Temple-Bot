#!/usr/bin/env python3
"""
repair_walletrpc.py — fixes the failing Railway build in one shot.

    python3 repair_walletrpc.py             # diagnose + repair
    python3 repair_walletrpc.py --dry-run   # diagnose + show diffs only
    python3 repair_walletrpc.py --revert    # restore .bak files

WHAT WENT WRONG
---------------
Your Dockerfile.walletrpc was pointing at:

    docker.io/sethsimmons/monero-wallet-rpc:latest

That repository does not exist. The real one is `simple-monero-wallet-rpc`
(with the `simple-` prefix). Docker Hub reports a missing repo as
"pull access denied ... may require authorization", which reads like an auth
problem but is really a 404 — the registry cannot say "not found" without
leaking whether a private repo exists.

WHY THIS SCRIPT DOES NOT JUST FIX THE NAME
------------------------------------------
Switching to any prebuilt image silently discards three fixes that live in our
entrypoint:

  1. --rpc-use-ipv6 / --rpc-bind-ipv6-address ::   (Railway private net is
     IPv6-only on legacy environments; without this you get ConnectTimeout)
  2. chown of the mounted volume            (Railway mounts volumes as root,
     so the daemon cannot write its .keys file)
  3. --wallet-dir mode                      (bot.py opens/creates the wallet
     over RPC; a prebuilt image's default CMD does not do this)

So this restores a self-contained build from official Monero binaries. No
third-party registry, no auth, no image that can disappear.

If you would rather use the prebuilt image, the correct references are:
    ghcr.io/sethforprivacy/simple-monero-wallet-rpc:latest   (maintained)
    docker.io/sethsimmons/simple-monero-wallet-rpc:latest    (older mirror)
...but you must then pass every flag above yourself via CMD, and solve the
volume permission problem separately.
"""

from __future__ import annotations

import argparse
import difflib
import os
import py_compile
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import Optional

_COLOR = sys.stdout.isatty() and os.getenv("NO_COLOR") is None


def _c(code: str, s: str) -> str:
    return f"\033[{code}m{s}\033[0m" if _COLOR else s


def ok(m: str) -> None:
    print(f"  {_c('32','[ok]')}     {m}")


def info(m: str) -> None:
    print(f"  {_c('36','[--]')}     {m}")


def warn(m: str) -> None:
    print(f"  {_c('33','[warn]')}   {m}")


def bad(m: str) -> None:
    print(f"  {_c('31','[FAIL]')}   {m}")


def header(m: str) -> None:
    print(f"\n{_c('1', m)}\n{'-' * len(m)}")


MONERO_VERSION = "v0.18.3.4"

DOCKERFILE = f"""# monero-wallet-rpc sidecar for Railway — self-contained build.
#
# Built from official Monero binaries rather than a third-party image, so the
# build cannot break when someone else's Docker Hub repo is renamed, deleted,
# or rate-limited. Official binaries are published only at getmonero.org;
# the monero-project GitHub releases do NOT attach Linux tarballs, so there is
# no second source to fall back to. curl retries instead.
#
# Starts in --wallet-dir mode with NO wallet loaded and NO secrets. bot.py
# calls open_wallet / generate_from_keys over JSON-RPC at boot. The view key
# lives on the bot service only.

FROM ubuntu:22.04

ARG MONERO_VERSION={MONERO_VERSION}
# Optional integrity pin. Get the value from
# https://www.getmonero.org/downloads/hashes.txt and pass it at build time:
#   docker build --build-arg MONERO_SHA256=<hash> ...
# Left empty by default because a wrong hardcoded hash is worse than none.
ARG MONERO_SHA256=""

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \\
        ca-certificates curl bzip2 tini util-linux \\
    && rm -rf /var/lib/apt/lists/*

# dpkg architecture -> Monero's release filename. Railway builders are amd64,
# but this keeps local arm64 builds (Apple Silicon) working too.
RUN set -eux; \\
    arch="$(dpkg --print-architecture)"; \\
    case "$arch" in \\
        amd64) flavor="linux-x64" ;; \\
        arm64) flavor="linux-armv8" ;; \\
        *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \\
    esac; \\
    url="https://downloads.getmonero.org/cli/monero-${{flavor}}-${{MONERO_VERSION}}.tar.bz2"; \\
    echo "downloading $url"; \\
    curl -fSL --retry 5 --retry-delay 3 --retry-connrefused "$url" -o /tmp/monero.tar.bz2; \\
    if [ -n "$MONERO_SHA256" ]; then \\
        echo "$MONERO_SHA256  /tmp/monero.tar.bz2" | sha256sum -c -; \\
    else \\
        echo "WARNING: MONERO_SHA256 not set; skipping integrity verification" >&2; \\
    fi; \\
    mkdir -p /opt/monero; \\
    tar -xjf /tmp/monero.tar.bz2 -C /opt/monero --strip-components=1; \\
    install -m 0755 /opt/monero/monero-wallet-rpc /usr/local/bin/monero-wallet-rpc; \\
    rm -rf /tmp/monero.tar.bz2 /opt/monero; \\
    monero-wallet-rpc --version

# Fixed UID so a volume chowned once stays writable across rebuilds.
RUN useradd -u 10001 -m -d /home/monero monero

ENV WALLET_DIR=/wallet/data
RUN mkdir -p "$WALLET_DIR" && chown -R monero:monero /wallet

COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 0755 /usr/local/bin/entrypoint.sh

EXPOSE 18083

# Starts as root only to fix volume ownership, then drops to uid 10001 via
# setpriv before exec'ing the daemon. The daemon never runs as root.
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint.sh"]
"""

ENTRYPOINT = """#!/bin/bash
# monero-wallet-rpc in --wallet-dir mode.
#
# Boots with NO wallet loaded. bot.py calls open_wallet / generate_from_keys
# over JSON-RPC at startup, so this container holds no keys.
#
# Environment:
#   MONERO_RPC_USER / MONERO_RPC_PASSWORD  digest auth. Set BOTH here AND on
#                                          the bot service, identically.
#   MONERO_DAEMON_ADDRESS                  remote node; no local sync needed
#   WALLET_DIR                             volume mount (default /wallet/data)
#   MONERO_RPC_PORT                        default 18083

set -euo pipefail

WALLET_DIR="${WALLET_DIR:-/wallet/data}"
RPC_PORT="${MONERO_RPC_PORT:-18083}"
DAEMON="${MONERO_DAEMON_ADDRESS:-https://xmr-node.cakewallet.com:18081}"
RUN_UID=10001
RUN_GID=10001

echo "[entrypoint] wallet dir : ${WALLET_DIR}"
echo "[entrypoint] daemon     : ${DAEMON}"
echo "[entrypoint] rpc port   : ${RPC_PORT}"

# Railway mounts volumes owned by root. Without this the daemon cannot write
# its .keys file, and generate_from_keys fails with a permission error that
# reaches the bot as a generic RPC failure.
mkdir -p "${WALLET_DIR}"
if [ "$(id -u)" = "0" ]; then
    echo "[entrypoint] fixing ownership of ${WALLET_DIR} -> ${RUN_UID}:${RUN_GID}"
    chown -R "${RUN_UID}:${RUN_GID}" "$(dirname "${WALLET_DIR}")"
    DROP_PRIV=(setpriv --reuid="${RUN_UID}" --regid="${RUN_GID}" --init-groups --)
else
    echo "[entrypoint] already unprivileged (uid $(id -u)); skipping chown"
    DROP_PRIV=()
fi

AUTH_ARGS=()
if [ -n "${MONERO_RPC_USER:-}" ] && [ -n "${MONERO_RPC_PASSWORD:-}" ]; then
    echo "[entrypoint] digest auth ENABLED for user '${MONERO_RPC_USER}'"
    AUTH_ARGS+=(--rpc-login "${MONERO_RPC_USER}:${MONERO_RPC_PASSWORD}")
else
    echo "[entrypoint] WARNING: MONERO_RPC_USER/MONERO_RPC_PASSWORD not set."
    echo "[entrypoint] WARNING: RPC login DISABLED. Anything that can reach this"
    echo "[entrypoint] WARNING: port can read your payment history. Acceptable"
    echo "[entrypoint] WARNING: only while no public domain is attached."
    AUTH_ARGS+=(--disable-rpc-login)
fi

# IPv6 is not optional here. Railway's private network is IPv6-only on
# environments created before 2025-10-16, and <service>.railway.internal
# publishes an AAAA record. Binding 0.0.0.0 alone listens on IPv4 only, so the
# bot dials IPv6, packets are dropped, and you get a connect TIMEOUT rather
# than a refusal. These flags produce a dual-stack listener.
exec "${DROP_PRIV[@]}" monero-wallet-rpc \\
    --wallet-dir "${WALLET_DIR}" \\
    --rpc-bind-ip 0.0.0.0 \\
    --rpc-use-ipv6 \\
    --rpc-bind-ipv6-address :: \\
    --rpc-bind-port "${RPC_PORT}" \\
    --confirm-external-bind \\
    "${AUTH_ARGS[@]}" \\
    --daemon-address "${DAEMON}" \\
    --trusted-daemon \\
    --non-interactive \\
    --log-level 1
"""

PROBE_HELPER = '''
# --- RAILWAY_IPV6_PATCH:probe (begin) --------------------------------------- #


def probe_rpc_endpoint(url: str, timeout: float = 5.0) -> str:
    """Resolve an RPC URL and attempt a raw TCP connect on every address family.

    A ConnectTimeoutError cannot distinguish "DNS returned IPv6 but the server
    listens on IPv4 only" from "the service is down". This separates them.
    """
    import socket
    from urllib.parse import urlparse

    parsed = urlparse(url)
    host = parsed.hostname or ""
    port = parsed.port or 18083
    out = [f"probe {host}:{port}"]

    try:
        infos = socket.getaddrinfo(host, port, proto=socket.IPPROTO_TCP)
    except socket.gaierror as exc:
        out.append(f"  DNS: FAILED ({exc})")
        out.append("  => the hostname does not resolve. Check the service name.")
        return "\\n".join(out)

    if not infos:
        out.append("  DNS: resolved to nothing")
        return "\\n".join(out)

    reachable = {}
    for family, socktype, proto, _canon, sockaddr in infos:
        label = "IPv6" if family == socket.AF_INET6 else "IPv4"
        addr = sockaddr[0]
        try:
            sock = socket.socket(family, socktype, proto)
        except OSError as exc:
            out.append(f"  {label} {addr} -> unavailable locally ({exc})")
            reachable.setdefault(label, False)
            continue
        sock.settimeout(timeout)
        try:
            sock.connect(sockaddr)
            out.append(f"  {label} {addr} -> CONNECTED")
            reachable[label] = True
        except socket.timeout:
            out.append(f"  {label} {addr} -> TIMEOUT (packets dropped)")
            reachable.setdefault(label, False)
        except OSError as exc:
            out.append(f"  {label} {addr} -> {type(exc).__name__}: {exc}")
            reachable.setdefault(label, False)
        finally:
            sock.close()

    if not any(reachable.values()):
        if reachable.get("IPv6") is False and "IPv4" not in reachable:
            out.append(
                "  => DNS returned ONLY IPv6 and nothing is listening there.\\n"
                "     monero-wallet-rpc must be started with\\n"
                "     --rpc-use-ipv6 --rpc-bind-ipv6-address :: --confirm-external-bind"
            )
        else:
            out.append("  => no address family accepted a connection.")
    return "\\n".join(out)


# --- RAILWAY_IPV6_PATCH:probe (end) ----------------------------------------- #

'''


# --------------------------------------------------------------------------- #
# Diagnosis
# --------------------------------------------------------------------------- #


def diagnose(dockerfile: Optional[Path], entry: Optional[Path]) -> None:
    header("Diagnosis")

    if dockerfile is None:
        bad("Dockerfile.walletrpc not found")
        return

    text = dockerfile.read_text()
    froms = re.findall(r"^\s*FROM\s+(\S+)", text, re.MULTILINE | re.IGNORECASE)
    for image in froms:
        base = image.split("@")[0]
        if "monero-wallet-rpc" in base and "simple-monero-wallet-rpc" not in base:
            bad(f"FROM {image}")
            info("that repository does not exist — the real name has a 'simple-' prefix")
            info("registry reports missing repos as an authorization error, not a 404")
        elif "simple-monero-wallet-rpc" in base:
            warn(f"FROM {image}  (exists, but bypasses our entrypoint)")
        else:
            ok(f"FROM {image}")

    if "entrypoint.sh" not in text:
        bad("Dockerfile does not COPY entrypoint.sh — IPv6/volume/wallet-dir fixes are lost")
    if "--rpc-use-ipv6" not in text and (entry is None or "--rpc-use-ipv6" not in entry.read_text()):
        bad("no --rpc-use-ipv6 anywhere — this reintroduces the ConnectTimeout")

    if entry is None:
        bad("entrypoint.sh not found — it will be recreated")
    else:
        etext = entry.read_text()
        if "--rpc-use-ipv6" in etext:
            ok("entrypoint.sh already has the IPv6 flags")
        if "--wallet-dir" in etext:
            ok("entrypoint.sh uses --wallet-dir mode")


# --------------------------------------------------------------------------- #
# Writers
# --------------------------------------------------------------------------- #


def check_bash(text: str) -> bool:
    with tempfile.NamedTemporaryFile("w", suffix=".sh", delete=False) as tmp:
        tmp.write(text)
        path = tmp.name
    try:
        proc = subprocess.run(["bash", "-n", path], capture_output=True, text=True)
        if proc.returncode != 0:
            bad(f"shell syntax error:\n{proc.stderr}")
            return False
        return True
    except FileNotFoundError:
        warn("bash unavailable; skipping shell check")
        return True
    finally:
        os.unlink(path)


def check_dockerfile(text: str) -> bool:
    lines = [l for l in text.splitlines() if l.strip() and not l.strip().startswith("#")]
    if not lines or not lines[0].upper().startswith(("FROM", "ARG")):
        bad("Dockerfile must begin with FROM (or ARG)")
        return False
    # Every backslash continuation must be the final character on its line.
    for n, line in enumerate(text.splitlines(), 1):
        if "\\" in line and not line.rstrip().endswith("\\") and not line.strip().startswith("#"):
            if re.search(r"\\\s+\S", line):
                bad(f"line {n}: text after a line-continuation backslash")
                return False
    return True


def write_file(path: Path, content: str, dry_run: bool, kind: str) -> bool:
    existing = path.read_text() if path.exists() else ""
    if existing == content:
        info(f"{path.name} already correct")
        return True

    if kind == "bash" and not check_bash(content):
        return False
    if kind == "docker" and not check_dockerfile(content):
        return False
    ok(f"{path.name} validated")

    if dry_run:
        diff = difflib.unified_diff(
            existing.splitlines(keepends=True),
            content.splitlines(keepends=True),
            fromfile=f"a/{path.name}",
            tofile=f"b/{path.name}",
        )
        sys.stdout.writelines(diff)
        print()
        return True

    if path.exists():
        backup = path.with_suffix(path.suffix + ".bak")
        if not backup.exists():
            shutil.copy2(path, backup)
            ok(f"backup -> {backup.name}")
    path.write_text(content)
    if kind == "bash":
        path.chmod(0o755)
    ok(f"{path.name} written")
    return True


def patch_bot(path: Path, dry_run: bool) -> bool:
    text = path.read_text()
    original = text

    if "def probe_rpc_endpoint(" in text:
        info("bot.py already has probe_rpc_endpoint()")
    elif "\ndef now_ts() -> int:" in text:
        text = text.replace(
            "\ndef now_ts() -> int:", PROBE_HELPER + "\ndef now_ts() -> int:", 1
        )
        ok("added probe_rpc_endpoint()")
    else:
        warn("could not locate insertion anchor in bot.py; skipping probe helper")

    if "_CONNECT_TIMEOUT" not in text:
        anchor = 'LOG_FORMAT = "%(asctime)s | %(levelname)-8s | %(name)s | %(message)s"'
        if anchor in text:
            text = text.replace(
                anchor,
                anchor + "\n\n_CONNECT_TIMEOUT = 10\n_READ_TIMEOUT = 120",
                1,
            )
            ok("added timeout constants")
    else:
        info("timeout constants already present")

    old_timeout = "            resp = self._session.post(self._url, json=payload, timeout=30)"
    if old_timeout in text:
        text = text.replace(
            old_timeout,
            "            resp = self._session.post(\n"
            "                self._url,\n"
            "                json=payload,\n"
            "                timeout=(_CONNECT_TIMEOUT, _READ_TIMEOUT),\n"
            "            )",
            1,
        )
        ok("split RPC timeout into (connect, read)")
    elif "timeout=(_CONNECT_TIMEOUT, _READ_TIMEOUT)" in text:
        info("RPC timeout already split")

    if text == original:
        info("bot.py needs no changes")
        return True

    with tempfile.NamedTemporaryFile("w", suffix=".py", delete=False) as tmp:
        tmp.write(text)
        tmp_path = tmp.name
    try:
        py_compile.compile(tmp_path, doraise=True)
        ok("bot.py compiles")
    except py_compile.PyCompileError as exc:
        bad(f"patched bot.py does not compile — nothing written:\n{exc}")
        return False
    finally:
        os.unlink(tmp_path)

    if dry_run:
        sys.stdout.writelines(
            difflib.unified_diff(
                original.splitlines(keepends=True),
                text.splitlines(keepends=True),
                fromfile="a/bot.py",
                tofile="b/bot.py",
            )
        )
        return True

    backup = path.with_suffix(".py.bak")
    if not backup.exists():
        shutil.copy2(path, backup)
        ok(f"backup -> {backup.name}")
    path.write_text(text)
    ok("bot.py written")
    return True


def find(names: list[str], root: Path) -> Optional[Path]:
    for name in names:
        if (root / name).is_file():
            return root / name
    skip = {".git", "node_modules", "__pycache__", ".venv", "venv"}
    for path in root.rglob("*"):
        if path.is_file() and path.name in names:
            if not any(p in skip for p in path.parts):
                return path
    return None


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--root", default=".")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--revert", action="store_true")
    args = ap.parse_args()
    root = Path(args.root).resolve()

    if args.revert:
        header("Reverting")
        n = 0
        for b in root.rglob("*.bak"):
            shutil.copy2(b, b.with_suffix(""))
            ok(f"{b.with_suffix('')} restored")
            n += 1
        if not n:
            warn("no .bak files found")
        return 0

    print(_c("1", "\nWallet-RPC build repair"))
    print(f"root: {root}")
    if args.dry_run:
        print(_c("33", "DRY RUN — nothing will be written"))

    dockerfile = find(["Dockerfile.walletrpc"], root)
    entry = find(["entrypoint.sh"], root)
    bot = find(["bot.py"], root)

    diagnose(dockerfile, entry)

    header("Repair")
    results = []
    target_df = dockerfile or (root / "Dockerfile.walletrpc")
    target_entry = entry or (target_df.parent / "entrypoint.sh")

    results.append(write_file(target_entry, ENTRYPOINT, args.dry_run, "bash"))
    results.append(write_file(target_df, DOCKERFILE, args.dry_run, "docker"))

    if bot is not None:
        results.append(patch_bot(bot, args.dry_run))
    else:
        warn("bot.py not found; skipped")

    header("Result")
    if all(results):
        ok("repair complete")
        print(
            "\nNOTE: entrypoint.sh must sit in the same build context directory as\n"
            f"      Dockerfile.walletrpc. Both are now at: {target_df.parent}\n"
            "\nCommit and push. Expected build output:\n"
            "  downloading https://downloads.getmonero.org/cli/monero-linux-x64-"
            f"{MONERO_VERSION}.tar.bz2\n"
            "  Monero 'Fluorine Fermi' (v0.18.x)\n"
            "\nExpected runtime output:\n"
            "  [entrypoint] fixing ownership of /wallet/data -> 10001:10001\n"
            "  [entrypoint] digest auth ENABLED for user '...'\n"
        )
        return 0
    bad("repair incomplete — see above")
    return 1


if __name__ == "__main__":
    sys.exit(main())
