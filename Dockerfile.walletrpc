FROM ubuntu:22.04

# Install Monero and explicitly add the ca-certificates package for secure network routing
RUN apt-get update && apt-get install -y monero ca-certificates && rm -rf /var/lib/apt/lists/*

# Set up the secure working path
WORKDIR /srv/xmr

# Explicitly create the wallets data folder and grant absolute read/write permissions
RUN mkdir -p /srv/xmr/wallets && chmod 777 /srv/xmr/wallets

EXPOSE 18083

# Launch dual-stack IPv6/IPv4 interfaces with forced permissive wallet path controls
CMD monero-wallet-rpc \
    --rpc-bind-ip 0.0.0.0 --rpc-bind-port 18083 \
    --rpc-use-ipv6 --rpc-bind-ipv6-address :: \
    --daemon-address https://moneroworld.com \
    --wallet-dir /srv/xmr/wallets \
    --disable-rpc-login \
    --generate-from-view-key viewonly_wallet \
    --password-file /dev/null \
    --non-interactive

Displaying
